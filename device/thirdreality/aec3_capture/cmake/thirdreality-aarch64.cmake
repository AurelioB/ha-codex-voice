set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if(NOT DEFINED THIRDREALITY_TOOLCHAIN_ROOT)
    message(FATAL_ERROR "THIRDREALITY_TOOLCHAIN_ROOT is required")
endif()
if(NOT DEFINED THIRDREALITY_STAGING_DIR)
    message(FATAL_ERROR "THIRDREALITY_STAGING_DIR is required")
endif()

set(_triple aarch64-none-linux-gnu)
set(_bin "${THIRDREALITY_TOOLCHAIN_ROOT}/bin")
set(CMAKE_C_COMPILER "${_bin}/${_triple}-gcc")
set(CMAKE_CXX_COMPILER "${_bin}/${_triple}-g++")
set(CMAKE_AR "${_bin}/${_triple}-ar")
set(CMAKE_RANLIB "${_bin}/${_triple}-ranlib")
set(CMAKE_STRIP "${_bin}/${_triple}-strip")
set(CMAKE_SYSROOT "${THIRDREALITY_STAGING_DIR}")
set(CMAKE_FIND_ROOT_PATH "${THIRDREALITY_STAGING_DIR}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(ENV{PKG_CONFIG_SYSROOT_DIR} "${THIRDREALITY_STAGING_DIR}")
set(ENV{PKG_CONFIG_LIBDIR}
    "${THIRDREALITY_STAGING_DIR}/usr/lib/pkgconfig:${THIRDREALITY_STAGING_DIR}/usr/share/pkgconfig")

set(CMAKE_C_FLAGS_INIT "-O2 -pipe")
set(CMAKE_CXX_FLAGS_INIT "-O2 -pipe")
