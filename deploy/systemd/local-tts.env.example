# Loopback is the safe default. Set this to one explicit trusted-LAN address
# only when Home Assistant runs on another host, for example:
# HA_CODEX_TTS_URI=tcp://192.168.1.10:10200
HA_CODEX_TTS_URI=tcp://127.0.0.1:10200

# The Mexican Spanish voice must be preinstalled with the locked model installer.
# The private runner rejects every other voice and never downloads models.
HA_CODEX_TTS_VOICE=es_MX-ald-medium

# Start with the number of physical performance cores available to the service.
# The private runner accepts values from 1 through 64.
HA_CODEX_TTS_THREADS=4
