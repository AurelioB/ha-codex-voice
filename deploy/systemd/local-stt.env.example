# Bind an explicit trusted-LAN address that Home Assistant can reach.
HA_CODEX_STT_URI=tcp://192.168.1.10:10300

# The unit defaults to the revision-pinned multilingual base model provisioned
# by docs/local-stt.md beneath the isolated runtime directory. An override must
# remain inside ~/.local/share/ha-codex-voice because ProtectHome hides the rest
# of the service user's home.
# HA_CODEX_STT_MODEL=/home/voice/.local/share/ha-codex-voice/models/faster-whisper-base

# Start with the number of physical performance cores available to the service.
HA_CODEX_STT_THREADS=4
