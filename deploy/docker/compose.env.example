# Copy this file to .codex-voice/compose.env and adjust it for the host.
# It contains deployment coordinates, not bearer secrets.

# The container UID must own auth.json because Codex refreshes it in place.
HA_CODEX_UID=1000
HA_CODEX_GID=1000
HA_CODEX_AUTH_FILE_HOST=/home/replace-me/.codex/auth.json

# Keep the bearer tokens in this separate mode-0600 file.
HA_CODEX_ENV_FILE=./.codex-voice/bridge.env

# Host networking avoids a Docker NAT boundary in the server WebRTC path.
HA_CODEX_BRIDGE_HOST=0.0.0.0
HA_CODEX_BRIDGE_PORT=8787
HA_CODEX_TRANSCRIBE_LIVE_FRAGMENT_QUIET_SECONDS=0.5

# Keep the App Server interface and image build reproducible.
CODEX_CLI_VERSION=0.147.0
HA_CODEX_IMAGE_TAG=0.147.0
