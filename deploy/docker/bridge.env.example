# Copy this file to .codex-voice/bridge.env, replace both values with separate
# long random tokens, and set its mode to 0600. Never commit the resulting file.
HA_CODEX_BRIDGE_TOKEN=replace-with-a-long-random-primary-token
HA_CODEX_REALTIME_DEVICE_TOKEN=replace-with-a-different-long-random-device-token
# Matches the model requested by current Codex Desktop Quicksilver sessions.
HA_CODEX_REALTIME_MODEL=gpt-live-1-codex
# Testing only: stores bounded user/assistant transcript text in Docker logs.
HA_CODEX_REALTIME_LOG_TRANSCRIPTS=false

# Optional external-agent endpoint compatible with voicepe-realtime's
# {"question", "room"} and {"recall"} request shapes. Home Assistant tools are
# built in and do not require these variables.
# HA_CODEX_AGENT_URL=http://127.0.0.1:8090/voice
# HA_CODEX_AGENT_TOKEN=replace-with-an-agent-specific-token
# HA_CODEX_AGENT_ANNOUNCE_TOKEN=replace-with-a-distinct-report-back-token
# HA_CODEX_AGENT_ROOM=home
# HA_CODEX_AGENT_RECALL_TIMEOUT=8
# HA_CODEX_AGENT_TASK_TIMEOUT=35
